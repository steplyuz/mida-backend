# Copy to .env for local development. Never commit .env. No real secrets here.
APP_ENV=development
APP_NAME=MIDA API
DEBUG=false
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Relative SQLite paths are resolved against the backend/ directory.
DATABASE_URL=sqlite+aiosqlite:///./mida.db

TELEGRAM_BOT_TOKEN=
# Required in production. At least 32 random characters, e.g. `openssl rand -hex 32`.
APP_SECRET_KEY=
ACCESS_TOKEN_TTL_SECONDS=900
TELEGRAM_WEBHOOK_SECRET=
# Group bot: a separate bot (own token) added to deal groups by an admin. Its webhook has its own secret.
GROUP_BOT_TOKEN=
GROUP_BOT_WEBHOOK_SECRET=
GROUP_BOT_USERNAME=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_ADMIN_SESSION_PATH=
# Leave empty = automatic (worker runs when MTProto above is configured). true/false to force.
TELEGRAM_WORKER_ENABLED=
TELEGRAM_INITDATA_MAX_AGE_SECONDS=300

# Comma-separated Telegram user ids that become admins on login, e.g. 123456789,987654321
ADMIN_TELEGRAM_IDS=

# Optional: https URL of the Mini App. Notifications then carry a "Bitimni ochish" button.
TELEGRAM_MINIAPP_URL=

MIDA_LOGO_PATH=./assets/mida-logo.png

SERVICE_FEE_BPS=1000
MAX_DEAL_AMOUNT_UZS=1000000000

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Must be false in production. Startup fails if true with APP_ENV=production.
MOCK_PAYMENT_PROVIDER=false
